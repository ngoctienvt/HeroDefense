# Dependencies
node_modules/
.npm-cache/

# Build outputs
dist/
build/
.vite/

# Runtime logs and artifacts
logs/
artifacts/
*.log

# Agent & temporary runtimes
.agentkit-runtime/
.claude/

# Environment files
.env
.env.*
!.env.example

# Large binary maps (exceeds GitHub 100MB limit; catalog data extracted in content/data)
*.w3x
*.w3m

# Audio source packs: archives are kept, extracted copies are rebuilt by assets/audio-source/build-runtime-audio.sh
assets/audio-source/**/extracted/

# Python cache
__pycache__/
*.pyc

# OS & Editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
.forge/

# heavy asset sources (kept local)
assets/sprites/**/source/
assets/vfx-source/
assets/3D model/
